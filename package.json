{
  "name": "lan-file-drop",
  "productName": "LAN Drop",
  "version": "1.1.0",
  "description": "Private peer-to-peer file and note transfers over your local network.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.landrop",
    "productName": "LAN Drop",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-final"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LAN-Drop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "j355311",
      "repo": "lan-drop"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
